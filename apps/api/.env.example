# Backend API environment example
# Copy to `.env` when running the API locally.

NODE_ENV=development
APP_ENV=development
API_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/clone_fanos
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

ASSET_PROVIDER=LOCALFILE
ASSET_URL_TTL_SECONDS=300
CDN_BASE_URL=https://cdn.example.com
S3_BASE_URL=https://s3.example.com
LOCAL_ASSET_BASE_URL=http://localhost:3000

SUBSCRIPTION_PROVIDER=WEB_GATEWAY
SUBSCRIPTION_BILLING_MODE=SANDBOX
SUBSCRIPTION_WEBHOOK_SECRET=change-me
AUTH_TOKEN_SECRET=change-me-too
AUTH_TOKEN_TTL_SECONDS=604800
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Development bootstrap admin account
ADMIN_BOOTSTRAP_EMAIL=admin@fonos.test
ADMIN_BOOTSTRAP_PASSWORD=Secret123!
ADMIN_BOOTSTRAP_DISPLAY_NAME=Admin One
